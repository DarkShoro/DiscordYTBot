DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_GUILD_ID=your_test_guild_id
# Optional: User-Agent sent to protogen.fr (identity-gated host) requests
PROTOGEN_USER_AGENT="Protogen.JAM/1.0 (Discordbot; +https://protogen.fr)"
YTDLP_PATH=yt-dlp
# Windows alternative: YTDLP_PATH=yt-dlp.exe
FFMPEG_PATH=
# Linux example: FFMPEG_PATH=/usr/bin/ffmpeg
# Windows example: FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
